# Django Core Settings
# In production, DJANGO_SECRET_KEY must be a random secret of at least 50 chars, not a dev key
DJANGO_SECRET_KEY=generate-a-strong-random-key-here-at-least-50-characters-long
DJANGO_ENV=dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Secret Admin URL path (e.g. portal-admin -> http://domain/portal-admin/)
ADMIN_URL=portal-admin

# Reverse Proxy / Nginx Configuration
TRUSTED_PROXIES=127.0.0.1,::1

# MySQL 8 Database Credentials (Dedicated restricted user 'kinetiq_app', NEVER root in production)
DB_ENGINE=django.db.backends.mysql
DB_NAME=crm_saas_db
DB_USER=kinetiq_app
DB_PASSWORD=your_secure_database_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Production SMTP Email Settings (Used strictly in production)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_api_key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=KinetiQ <noreply@kinetiqcrm.com>

# PayPal Sandbox Invoicing API v2 (Test Mode Only)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# Kine AI Assistant (Stage 1 Read-Only Chat)
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
KINE_USER_DAILY_LIMIT=50
KINE_ORG_DAILY_LIMIT=200
KINE_MAX_MESSAGE_LENGTH=500
KINE_REQUEST_TIMEOUT=10
KINE_HISTORY_MESSAGES_LIMIT=12
KINE_MAX_REPLY_TOKENS=400

